#!/usr/bin/env bash

# Default organization is Litafi. To set up a different organization, run:
# GITHUB_ORGANIZATION="OtherOrg" GH_TOKEN="$(gh auth token)" ./scripts/setup/apply_org_properties

set -euo pipefail

ORGANIZATION="${GITHUB_ORGANIZATION:-Litafi}"
API_VERSION="${GITHUB_API_VERSION:-2026-03-10}"

SCRIPT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPOSITORY_ROOT="$(cd "${SCRIPT_DIRECTORY}/../.." && pwd)"

PROPERTIES_DIRECTORY="${PROPERTIES_DIRECTORY:-${REPOSITORY_ROOT}/.github/properties}"

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    fail "Required command not found: $1"
}

run_gh_api() {
  local description="$1"
  shift

  local output

  if ! output="$(
    gh api \
      --hostname github.com \
      -H 'Accept: application/vnd.github+json' \
      -H "X-GitHub-Api-Version: ${API_VERSION}" \
      "$@" 2>&1
  )"; then
    printf '%s\n' "${output}" >&2
    fail "${description}"
  fi

  printf '%s' "${output}"
}

validate_property_file() {
  local property_file="$1"

  jq -e '
    type == "object"
    and ((keys - [
      "allowed_values",
      "default_value",
      "description",
      "property_name",
      "required",
      "value_type",
      "values_editable_by"
    ]) | length == 0)
    and (.property_name | type == "string" and length > 0)
    and (
      .value_type == "string"
      or .value_type == "single_select"
      or .value_type == "multi_select"
      or .value_type == "true_false"
      or .value_type == "url"
    )
    and (.required | type == "boolean")
    and (
      (.description == null)
      or (.description | type == "string")
    )
    and (
      if (.value_type == "single_select" or .value_type == "multi_select") then
        (.allowed_values | type == "array" and length > 0)
        and all(.allowed_values[]; type == "string" and length > 0)
        and ((.allowed_values | unique | length) == (.allowed_values | length))
      else
        (.allowed_values == null)
      end
    )
    and (
      . as $property
      | if $property.default_value == null then
          true
        elif $property.value_type == "multi_select" then
          ($property.default_value | type == "array")
          and all($property.default_value[]; type == "string")
          and all(
            $property.default_value[];
            . as $value | $property.allowed_values | index($value) != null
          )
        elif $property.value_type == "single_select" then
          ($property.default_value | type == "string")
          and ($property.allowed_values | index($property.default_value) != null)
        elif $property.value_type == "true_false" then
          ($property.default_value | type == "boolean")
        else
          ($property.default_value | type == "string")
        end
    )
    and (
      (.values_editable_by == null)
      or .values_editable_by == "org_actors"
      or .values_editable_by == "org_and_repo_actors"
    )
  ' "${property_file}" >/dev/null ||
    fail "Invalid organization custom-property payload: ${property_file}"
}

verify_applied_property() {
  local property_file="$1"
  local property_name="$2"
  local encoded_property_name="$3"
  local applied_property_file="$4"

  run_gh_api \
    "Could not read back custom property '${property_name}'." \
    "/orgs/${ORGANIZATION}/properties/schema/${encoded_property_name}" \
    > "${applied_property_file}"

  jq -e \
    --slurpfile expected "${property_file}" \
    '
      def contract:
        {
          property_name,
          value_type,
          required,
          default_value,
          description,
          allowed_values,
          values_editable_by
        };

      contract == ($expected[0] | contract)
    ' \
    "${applied_property_file}" >/dev/null ||
    fail "Applied custom property '${property_name}' does not match ${property_file}."
}

require_command gh
require_command jq
require_command find
require_command sort
require_command uniq
require_command mktemp

[[ -n "${GH_TOKEN:-}" ]] ||
  fail 'GH_TOKEN is required. Run: GH_TOKEN="$(gh auth token)" ./scripts/setup/apply_org_properties'

run_gh_api \
  "GH_TOKEN could not authenticate to github.com." \
  /user >/dev/null

[[ -d "${PROPERTIES_DIRECTORY}" ]] ||
  fail "Custom-properties directory does not exist: ${PROPERTIES_DIRECTORY}"

TEMP_DIRECTORY="$(mktemp -d)"
trap 'rm -rf "${TEMP_DIRECTORY}"' EXIT

PROPERTY_FILES="${TEMP_DIRECTORY}/property-files.txt"
PROPERTY_NAMES="${TEMP_DIRECTORY}/property-names.txt"
EXISTING_PROPERTIES="${TEMP_DIRECTORY}/existing-properties.json"

find "${PROPERTIES_DIRECTORY}" -type f -name '*.json' -print |
  LC_ALL=C sort > "${PROPERTY_FILES}"

[[ -s "${PROPERTY_FILES}" ]] ||
  fail "No .json custom-property files found under ${PROPERTIES_DIRECTORY}"

while IFS= read -r property_file; do
  validate_property_file "${property_file}"
  jq -r '.property_name' "${property_file}" >> "${PROPERTY_NAMES}"
done < "${PROPERTY_FILES}"

DUPLICATE_NAMES="$(LC_ALL=C sort "${PROPERTY_NAMES}" | uniq -d || true)"

[[ -z "${DUPLICATE_NAMES}" ]] ||
  fail "Duplicate custom-property names found in local JSON files: ${DUPLICATE_NAMES}"

run_gh_api \
  "Could not list organization custom properties." \
  --paginate \
  --slurp \
  "/orgs/${ORGANIZATION}/properties/schema?per_page=100" \
  > "${EXISTING_PROPERTIES}"

created=0
updated=0

while IFS= read -r property_file; do
  property_name="$(jq -r '.property_name' "${property_file}")"
  encoded_property_name="$(jq -nr --arg value "${property_name}" '$value | @uri')"
  relative_path="${property_file#${REPOSITORY_ROOT}/}"
  payload_file="${TEMP_DIRECTORY}/property-${property_name//[^A-Za-z0-9._-]/_}-payload.json"
  applied_property_file="${TEMP_DIRECTORY}/property-${property_name//[^A-Za-z0-9._-]/_}-applied.json"

  jq 'del(.property_name)' "${property_file}" > "${payload_file}"

  exists="$(
    jq -r \
      --arg name "${property_name}" \
      '[.[][] | select(.property_name == $name)] | length > 0' \
      "${EXISTING_PROPERTIES}"
  )"

  if [[ "${exists}" == "true" ]]; then
    printf 'UPDATE  custom property %s  <- %s\n' \
      "${property_name}" \
      "${relative_path}"
    updated=$((updated + 1))
  else
    printf 'CREATE  custom property %s  <- %s\n' \
      "${property_name}" \
      "${relative_path}"
    created=$((created + 1))
  fi

  run_gh_api \
    "Could not apply custom property '${property_name}'." \
    --method PUT \
    "/orgs/${ORGANIZATION}/properties/schema/${encoded_property_name}" \
    --input "${payload_file}" \
    >/dev/null

  verify_applied_property \
    "${property_file}" \
    "${property_name}" \
    "${encoded_property_name}" \
    "${applied_property_file}"
done < "${PROPERTY_FILES}"

printf '\nApplied and verified organization custom properties for %s: %d created, %d updated.\n' \
  "${ORGANIZATION}" \
  "${created}" \
  "${updated}"

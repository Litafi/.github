#!/usr/bin/env bash

set -euo pipefail

TESTS_RUN=0

fail_test() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

assert_equals() {
  local expected="$1"
  local actual="$2"
  local message="$3"

  TESTS_RUN=$((TESTS_RUN + 1))
  [[ "${actual}" == "${expected}" ]] ||
    fail_test "${message}: expected '${expected}', got '${actual}'"
}

assert_contains() {
  local haystack="$1"
  local needle="$2"
  local message="$3"

  TESTS_RUN=$((TESTS_RUN + 1))
  [[ "${haystack}" == *"${needle}"* ]] ||
    fail_test "${message}: missing '${needle}'"
}

assert_file_exists() {
  local path="$1"

  TESTS_RUN=$((TESTS_RUN + 1))
  [[ -f "${path}" ]] || fail_test "Expected file to exist: ${path}"
}

assert_file_absent() {
  local path="$1"

  TESTS_RUN=$((TESTS_RUN + 1))
  [[ ! -e "${path}" ]] || fail_test "Expected legacy path to be absent: ${path}"
}

assert_command_succeeds() {
  local message="$1"
  shift

  TESTS_RUN=$((TESTS_RUN + 1))
  "$@" || fail_test "${message}"
}

assert_command_fails() {
  local message="$1"
  shift

  TESTS_RUN=$((TESTS_RUN + 1))
  if "$@"; then
    fail_test "${message}"
  fi
}

print_test_summary() {
  printf 'PASS: %s (%d assertions)\n' "$1" "${TESTS_RUN}"
}

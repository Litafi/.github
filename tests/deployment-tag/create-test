#!/usr/bin/env bash

set -euo pipefail

TEST_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPOSITORY_ROOT="$(cd "${TEST_DIRECTORY}/../.." && pwd)"
CREATE_TAG="${REPOSITORY_ROOT}/scripts/deployment-tag/create"
# shellcheck source=test-helper
source "${TEST_DIRECTORY}/test-helper"

TEMP_DIRECTORY="$(mktemp -d)"
trap 'rm -rf "${TEMP_DIRECTORY}"' EXIT
mkdir -p "${TEMP_DIRECTORY}/bin"

MAIN_SHA='1111111111111111111111111111111111111111'
TAG_OBJECT_SHA='2222222222222222222222222222222222222222'
export MOCK_MAIN_SHA="${MAIN_SHA}"
export MOCK_TAG_OBJECT_SHA="${TAG_OBJECT_SHA}"
export MOCK_GH_LOG="${TEMP_DIRECTORY}/gh.log"

cat > "${TEMP_DIRECTORY}/bin/gh" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail

method=GET
endpoint=''
input=''

while [[ $# -gt 0 ]]; do
  case "$1" in
    api|--hostname|-H)
      if [[ "$1" == api ]]; then
        shift
      else
        shift 2
      fi
      ;;
    --method)
      method="$2"
      shift 2
      ;;
    --input)
      input="$2"
      shift 2
      ;;
    *)
      endpoint="$1"
      shift
      ;;
  esac
done

payload=''
if [[ "${input}" == '-' ]]; then
  payload="$(cat)"
fi
printf '%s %s %s\n' "${method}" "${endpoint}" "${payload}" >> "${MOCK_GH_LOG}"

case "${method} ${endpoint}" in
  'GET repos/Litafi/Meris')
    printf '{"default_branch":"main"}\n'
    ;;
  'GET repos/Litafi/Meris/git/ref/heads/main')
    printf '{"object":{"sha":"%s"}}\n' "${MOCK_MAIN_SHA}"
    ;;
  'GET repos/Litafi/Meris/git/matching-refs/tags/deploy/v1.2.3')
    printf '[]\n'
    ;;
  'POST repos/Litafi/Meris/git/tags')
    jq -e \
      --arg object "${MOCK_MAIN_SHA}" \
      '.tag == "deploy/v1.2.3" and .object == $object and .type == "commit"' \
      <<< "${payload}" >/dev/null
    printf '{"sha":"%s","object":{"sha":"%s"}}\n' \
      "${MOCK_TAG_OBJECT_SHA}" \
      "${MOCK_MAIN_SHA}"
    ;;
  'POST repos/Litafi/Meris/git/refs')
    jq -e \
      --arg sha "${MOCK_TAG_OBJECT_SHA}" \
      '.ref == "refs/tags/deploy/v1.2.3" and .sha == $sha' \
      <<< "${payload}" >/dev/null
    printf '{"ref":"refs/tags/deploy/v1.2.3","object":{"sha":"%s"}}\n' \
      "${MOCK_TAG_OBJECT_SHA}"
    ;;
  'GET repos/Litafi/Meris/git/ref/tags/deploy/v1.2.3')
    printf '{"object":{"sha":"%s"}}\n' "${MOCK_TAG_OBJECT_SHA}"
    ;;
  "GET repos/Litafi/Meris/git/tags/${MOCK_TAG_OBJECT_SHA}")
    printf '{"object":{"sha":"%s"}}\n' "${MOCK_MAIN_SHA}"
    ;;
  *)
    printf 'Unexpected mocked gh request: %s %s\n' "${method}" "${endpoint}" >&2
    exit 1
    ;;
esac
MOCK
chmod +x "${TEMP_DIRECTORY}/bin/gh"

output="$(
  PATH="${TEMP_DIRECTORY}/bin:${PATH}" \
  GH_TOKEN='test-installation-token' \
  "${CREATE_TAG}" \
    --repository Litafi/Meris \
    --version 1.2.3 \
    --caller-ref refs/heads/main \
    --caller-sha "${MAIN_SHA}"
)"

assert_contains "${output}" 'deployment_tag=deploy/v1.2.3' 'Create script must expose the created tag'
assert_contains "${output}" "deployment_commit_sha=${MAIN_SHA}" 'Create script must expose the tagged commit'
assert_contains "${output}" 'app_version=1.2.3' 'Create script must expose the application version'
assert_contains "${output}" "tag_object_sha=${TAG_OBJECT_SHA}" 'Create script must expose the annotated tag object'

main_reads="$(grep -c 'GET repos/Litafi/Meris/git/ref/heads/main' "${MOCK_GH_LOG}")"
assert_equals '3' "${main_reads}" 'Create script must detect main movement before each mutation boundary'

assert_command_fails \
  'Create script must reject malformed versions before mutation.' \
  env \
  PATH="${TEMP_DIRECTORY}/bin:${PATH}" \
  GH_TOKEN='test-installation-token' \
  "${CREATE_TAG}" \
  --repository Litafi/Meris \
  --version v1.2.3 \
  --caller-ref refs/heads/main \
  --caller-sha "${MAIN_SHA}"

print_test_summary 'deployment-tag creation'

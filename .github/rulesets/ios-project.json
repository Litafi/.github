{
  "name": "ios-specific-policy",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "repository_property": {
      "include": [
        {
          "name": "project_platforms",
          "property_values": [
            "ios"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    },
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "validate-ios-project / Validate iOS Project",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}

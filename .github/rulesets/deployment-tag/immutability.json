{
  "name": "immutable-deployment-tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "repository_name": {
      "include": ["~ALL"],
      "exclude": []
    },
    "ref_name": {
      "include": ["refs/tags/deploy/v*.*.*"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    },
    {
      "type": "deletion"
    }
  ]
}
